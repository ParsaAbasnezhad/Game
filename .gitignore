```gitignore
# ==========================================
# Dependencies
# ==========================================

node_modules/
jspm_packages/
.npm/
.yarn/
.pnpm-store/


# ==========================================
# Environment & Secrets
# ==========================================

.env
.env.*
!.env.example

*.pem
*.key
*.crt
secrets/
credentials/


# ==========================================
# IDE / Editors
# ==========================================

.idea/
.vscode/
*.iml
*.ipr
*.iws

# VS Code local history
.history/


# ==========================================
# OS Generated Files
# ==========================================

.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes

Thumbs.db
ehthumbs.db
Desktop.ini


# ==========================================
# Logs
# ==========================================

*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*


# ==========================================
# Build / Distribution
# ==========================================

dist/
build/
out/
public/build/
.cache/
.parcel-cache/
.vite/
.next/
.nuxt/


# ==========================================
# Temporary Files
# ==========================================

tmp/
temp/
*.tmp
*.temp
*.bak
*.swp
*.swo
*~
.DS_Store


# ==========================================
# Coverage / Testing
# ==========================================

coverage/
.nyc_output/
htmlcov/
.pytest_cache/


# ==========================================
# Python (if backend is added later)
# ==========================================

__pycache__/
*.py[cod]
*$py.class

*.pyo
*.pyd

.venv/
venv/
env/
ENV/

.pytest_cache/
.mypy_cache/
.ruff_cache/

*.sqlite3
*.sqlite3-journal


# ==========================================
# Python Packaging
# ==========================================

*.egg
*.egg-info/
dist/
build/
.eggs/

pip-wheel-metadata/
MANIFEST
*.manifest


# ==========================================
# TypeScript
# ==========================================

*.tsbuildinfo


# ==========================================
# Local Development
# ==========================================

.local/
.localhost/
*.local

# Local server files
.server/
server.log


# ==========================================
# Generated Assets
# ==========================================

generated/
generated-assets/
screenshots/
*.generated.*


# ==========================================
# Backup Files
# ==========================================

*.orig
*.rej
*.old
*.backup
*.save


# ==========================================
# Lock files
# ==========================================
# Keep package-lock.json / yarn.lock / pnpm-lock.yaml
# They SHOULD be committed to Git.


# ==========================================
# Personal / Local Configuration
# ==========================================

config.local.*
settings.local.*
local.*


# ==========================================
# AI / Coding Assistant Files
# ==========================================

.claude/
.cursor/
.copilot/
.codex/


# ==========================================
# Miscellaneous
# ==========================================

*.pid
*.seed
*.pid.lock
*.stackdump

*.tgz
*.tar.gz
```
